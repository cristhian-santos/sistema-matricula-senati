{
  "name": "sistema-matricula-backend",
  "version": "1.0.0",
  "description": "API REST para el Sistema de Matrícula Académica SENATI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "audit:db": "node scripts/auditarBaseDatos.js",
    "migrate:academic": "node scripts/aplicarMigracionAcademica.js",
    "seed:demo": "node scripts/seedDatosDemostracion.js",
    "migrate:curricula": "node scripts/aplicarMigracionMallas.js",
